{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://briliant-ai.local/schemas/lesson.schema.json",
  "title": "BriliantAI lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "prerequisites", "outcomes", "misconceptions", "activities", "mastery", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "misconceptions": { "type": "array", "items": { "type": "string" } },
    "activities": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "type", "prompt"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["predict", "manipulate", "order", "response", "python", "transfer", "explain"] },
          "prompt": { "type": "string" }
        }
      }
    },
    "mastery": {
      "type": "object",
      "required": ["requiresIndependent", "requiresDelayed", "requiresTransfer"],
      "properties": {
        "requiresIndependent": { "type": "boolean" },
        "requiresDelayed": { "type": "boolean" },
        "requiresTransfer": { "type": "boolean" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "locator"],
        "properties": {
          "title": { "type": "string" },
          "locator": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
